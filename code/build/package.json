{
  "name": "dexerion",
  "productName": "Dexerion",
  "version": "1.0.0",
  "description": "Dexerion V1 — standalone Chromium-based desktop web browser for Windows.",
  "main": "../code/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke.js",
    "test:smoke": "node scripts/smoke.js",
    "test:ai": "node scripts/test-ai.js",
    "test:agent": "node scripts/test-agent.js",
    "test:context": "node scripts/test-context.js",
    "test:skills": "node scripts/test-skills.js",
    "test:scout": "node scripts/test-scout.js",
    "test:search": "node scripts/test-search.js",
    "test:export": "node scripts/test-export.js",
    "test:export-html": "node scripts/test-artifact-html.js",
    "test:project": "node scripts/test-artifact-project.js",
    "test:edit": "node scripts/test-artifact-edit.js",
    "vendor:ai": "node scripts/vendor-ai-assets.js",
    "vendor:model-data": "node scripts/vendor-model-data.js",
    "test:ai-live": "node scripts/test-ai-live.js",
    "test:sidebar": "node scripts/test-sidebar.js",
    "test:extbridge": "node scripts/test-extbridge.js",
    "test:repo": "node scripts/repo-audit.cjs",
    "test:pomodoro": "node scripts/test-pomodoro.js",
    "test:memsaver": "node scripts/test-memsaver.js",
    "test:safe-unzip": "node scripts/test-safe-unzip.js",
    "test:profile-save": "node scripts/test-profile-save.js",
    "test:artifacts": "node scripts/test-artifacts.js",
    "test:site-quality": "node scripts/test-site-quality.js",
    "test:polish": "node scripts/test-polish-unit.js",
    "test:profile": "node scripts/test-profile.js",
    "test:tasks": "node scripts/test-tasks.js",
    "verify": "node scripts/verify-all.js",
    "test:self": "electron . --run-selftest",
    "test:power": "node scripts/test-adaptive-power.js",
    "bench:power": "node scripts/power-benchmark.js",
    "test:e2e": "playwright test",
    "test:e2e:artifacts": "playwright test e2e/artifacts.spec.js",
    "test:intensive": "node scripts/intensive-e2e.js",
    "dist:win": "electron-builder --win --config electron-builder.json",
    "pack:win": "electron-builder --win --dir --config electron-builder.json"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@opencode/plugin": "^2.0.26",
    "@playwright/test": "^1.65.0",
