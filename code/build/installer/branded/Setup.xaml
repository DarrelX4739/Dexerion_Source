<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dexerion Setup" WindowStyle="None" ResizeMode="NoResize" Width="704" Height="516"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ground}"
        Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Ground" Color="#101010"/>
    <SolidColorBrush x:Key="Ink" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Muted" Color="#AEAEAE"/>
    <SolidColorBrush x:Key="Line" Color="#343434"/>
    <SolidColorBrush x:Key="Panel" Color="#171717"/>
    <SolidColorBrush x:Key="Hover" Color="#242424"/>
    <SolidColorBrush x:Key="FocusedSurface" Color="#666666"/>
    <!-- Exact SC Teal pairs with white for legible action and state indicators. -->
    <SolidColorBrush x:Key="Accent" Color="#1F6F6B"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>

    <Geometry x:Key="ArrowForward">M1,6 L11,6 M7,2 L11,6 7,10</Geometry>
    <Geometry x:Key="ArrowBack">M11,6 L1,6 M5,2 L1,6 5,10</Geometry>
    <Geometry x:Key="ArrowUp">M6,11 L6,1 M2,5 L6,1 10,5</Geometry>
    <Geometry x:Key="Check">M1,6 L4.5,9.5 11,3</Geometry>
    <Geometry x:Key="Minimize">M1,8 L11,8</Geometry>
    <Geometry x:Key="Close">M2,2 L10,10 M10,2 L2,10</Geometry>
    <Geometry x:Key="FolderGlyph">M1,3 L5,3 7,5 13,5 13,12 1,12 Z M1,6 L13,6</Geometry>
    <Geometry x:Key="FolderOpenGlyph">M1,11 L1,4 5,4 7,6 13,6 13,11 Z</Geometry>

    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}"
                  BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.72"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource FocusedSurface}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.43"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinWidth" Value="134"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="4">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" x:Name="ActionGlyph" Width="30" Height="28" Margin="0,0,5,0" CornerRadius="3" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="12" Height="12">
                      <Path x:Name="Icon" Data="{StaticResource ArrowForward}" Stroke="{DynamicResource OnAccent}"
                            StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                  </Viewbox>
                </Border>
                <ContentPresenter Margin="14,0,13,0" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="finish"><Setter TargetName="Icon" Property="Data" Value="{StaticResource Check}"/></Trigger>
            <Trigger Property="Tag" Value="back"><Setter TargetName="Icon" Property="Data" Value="{StaticResource ArrowBack}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.75"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ActionGlyph" Property="Background" Value="{DynamicResource OnAccent}"/>
              <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>

    <Style x:Key="TextEntry" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="TextBox">
          <Border x:Name="Edge" Background="Transparent" CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="Background" Value="{DynamicResource FocusedSurface}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,0">
          <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="1,0,12,0" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" Stroke="{DynamicResource Muted}" StrokeThickness="1"/>
              <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource OnAccent}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}"/>
            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FocusedSurface}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.43"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="CheckBox">
          <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,0">
            <DockPanel LastChildFill="True">
              <Border x:Name="Mark" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="3"
                      BorderBrush="{DynamicResource Muted}" BorderThickness="1" Margin="1,0,12,0" VerticalAlignment="Center">
                <Viewbox Width="12" Height="12">
                  <Canvas Width="12" Height="12">
                    <Path x:Name="Tick" Data="{StaticResource Check}" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                  </Canvas>
                </Viewbox>
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FocusedSurface}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FolderItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="10,7">
          <DockPanel LastChildFill="True">
            <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0">
              <Canvas Width="14" Height="14">
                <Path x:Name="FolderIcon" Data="{StaticResource FolderOpenGlyph}" Stroke="{DynamicResource Muted}" StrokeThickness="1.1" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
            <ContentPresenter VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
            <Setter TargetName="FolderIcon" Property="Stroke" Value="{DynamicResource Ink}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FocusedSurface}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- These views scroll vertically only. Keep the native Track interaction and replace its paint. -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb>
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#666666" CornerRadius="2" Margin="3,1,2,1"/></ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="InstallationProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Margin" Value="0,24,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="DotA" Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,5,0"/>
          <Ellipse x:Name="DotB" Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,5,0"/>
          <Ellipse x:Name="DotC" Width="8" Height="8" Fill="{DynamicResource Accent}"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsIndeterminate" Value="True">
            <Trigger.EnterActions><BeginStoryboard x:Name="Activity">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="DotA" Storyboard.TargetProperty="Opacity"
                                 To="0.28" Duration="0:0:0.32" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="DotB" Storyboard.TargetProperty="Opacity"
                                 To="0.28" Duration="0:0:0.32" BeginTime="0:0:0.12" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="DotC" Storyboard.TargetProperty="Opacity"
                                 To="0.28" Duration="0:0:0.32" BeginTime="0:0:0.24" AutoReverse="True"/>
              </Storyboard>
            </BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Activity"/></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource Ground}" BorderThickness="1" BorderBrush="{DynamicResource Line}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="*"/><RowDefinition Height="73"/></Grid.RowDefinitions>
      <Border x:Name="Titlebar" Background="{DynamicResource Panel}">
        <DockPanel Margin="20,0,9,0" LastChildFill="True">
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" VerticalAlignment="Center" AutomationProperties.Name="Close Setup">
            <Viewbox Width="13" Height="13"><Canvas Width="12" Height="12"><Path Data="{StaticResource Close}" Stroke="{DynamicResource Ink}" StrokeThickness="1.35"/></Canvas></Viewbox>
          </Button>
          <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" VerticalAlignment="Center" AutomationProperties.Name="Minimize Setup">
            <Viewbox Width="13" Height="13"><Canvas Width="12" Height="12"><Path Data="{StaticResource Minimize}" Stroke="{DynamicResource Muted}" StrokeThickness="1.35"/></Canvas></Viewbox>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="Logo" Width="28" Height="28" Margin="0,0,10,0" Stretch="Uniform"/>
            <TextBlock Text="Dexerion" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="Setup" Margin="16,0,0,0" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="PreviewMode" Text="Preview only" Visibility="Collapsed" Margin="18,0,10,0"
                       Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="1" x:Name="PageScroll" Margin="38,25,28,10" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False">
        <StackPanel x:Name="Pages" Margin="0,0,10,0"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource Panel}">
        <DockPanel LastChildFill="False" Margin="35,0,38,0" VerticalAlignment="Center">
          <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Content="_Continue" DockPanel.Dock="Right"/>
          <Button x:Name="BackButton" AutomationProperties.Name="Back" Style="{StaticResource Btn}" Margin="0,0,12,0" DockPanel.Dock="Right">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Viewbox Width="12" Height="12" Margin="0,0,8,0"><Canvas Width="12" Height="12"><Path Data="{StaticResource ArrowBack}" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/></Canvas></Viewbox>
              <AccessText Text="_Back" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="Cancel" Foreground="{DynamicResource Muted}" DockPanel.Dock="Left"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
