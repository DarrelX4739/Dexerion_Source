<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dexerion Setup" WindowStyle="None" ResizeMode="NoResize" Width="764" Height="514"
        WindowStartupLocation="CenterScreen" Background="#121619" Foreground="#F1F5F5"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F1F5F5"/>
    <SolidColorBrush x:Key="Muted" Color="#A6B5B6"/>
    <SolidColorBrush x:Key="Accent" Color="#62DDD1"/>
    <SolidColorBrush x:Key="Line" Color="#344348"/>
    <SolidColorBrush x:Key="Panel" Color="#192125"/>
    <SolidColorBrush x:Key="Hover" Color="#26353A"/>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Padding" Value="17,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value=".83"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value=".68"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value=".40"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="#09191A"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}"/>
    </Style>
    <Style x:Key="Step" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="TextEntry" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="TextBox">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="CheckBox">
          <Border x:Name="Card" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,10">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Mark" Width="20" Height="20" CornerRadius="6" BorderBrush="{DynamicResource Muted}" BorderThickness="1" Margin="0,0,11,0">
                <Path x:Name="Tick" Data="M 0,4 L 4,8 L 11,0" Stroke="#102427" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Frame" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                Background="{DynamicResource Panel}" Padding="10,7">
          <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" Stroke="{DynamicResource Muted}" StrokeThickness="1"/>
              <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".40"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FolderItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Item" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,3" Margin="3,1">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="InstallationProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="7"/>
      <Setter Property="Margin" Value="0,18,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Border CornerRadius="3" Background="{DynamicResource Hover}" ClipToBounds="True">
          <Grid>
            <Border x:Name="Pulse" HorizontalAlignment="Stretch" Background="{DynamicResource Accent}" CornerRadius="3" Opacity=".72"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsIndeterminate" Value="True">
            <Trigger.EnterActions><BeginStoryboard x:Name="Activity">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From=".26" To=".92" Duration="0:0:0.75"/>
              </Storyboard>
            </BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Activity"/></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border BorderThickness="1" BorderBrush="{DynamicResource Line}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="Titlebar" Background="#151B1D" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel Margin="18,0,10,0" LastChildFill="True">
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" MinWidth="35" Width="35" Height="34" Padding="0" Content="×" FontSize="20" VerticalAlignment="Center" AutomationProperties.Name="Close Setup"/>
          <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" MinWidth="35" Width="35" Height="34" Padding="0" Margin="0,0,6,0" Content="−" FontSize="19" VerticalAlignment="Center" AutomationProperties.Name="Minimize Setup"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="DEXERION" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text=" / " Foreground="{DynamicResource Accent}" Margin="5,0"/>
            <TextBlock Text="SETUP" FontSize="13" Foreground="{DynamicResource Muted}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#182628" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <Grid Margin="24,28,22,20">
            <StackPanel>
              <Border Width="54" Height="54" HorizontalAlignment="Left" CornerRadius="16" Background="#213639" BorderThickness="1" BorderBrush="#497476">
                <Image x:Name="Logo" Width="32" Height="32" Stretch="Uniform" AutomationProperties.Name="Dexerion"/>
              </Border>
              <TextBlock Text="Dexerion" Margin="0,20,0,3" FontWeight="Bold" FontSize="25"/>
              <TextBlock Text="Desktop browser" Foreground="{DynamicResource Muted}" FontSize="13"/>
              <Border Margin="0,27,0,21" Height="1" Background="{DynamicResource Line}"/>
              <TextBlock x:Name="Step1" Style="{StaticResource Step}" Text="01     Welcome"/>
              <TextBlock x:Name="Step2" Style="{StaticResource Step}" Text="02     Install options"/>
              <TextBlock x:Name="Step3" Style="{StaticResource Step}" Text="03     Installation"/>
              <TextBlock x:Name="Step4" Style="{StaticResource Step}" Text="04     Ready"/>
            </StackPanel>
            <TextBlock Text="WINDOWS  /  64-BIT" Foreground="{DynamicResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Bottom"/>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="34,28,34,22">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Pages" Margin="0,0,5,4"/>
          </ScrollViewer>
          <Border Grid.Row="1" VerticalAlignment="Top" Height="1" Background="{DynamicResource Line}"/>
          <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,13,0,0" VerticalAlignment="Top">
            <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Content="_Continue" DockPanel.Dock="Right"/>
            <Button x:Name="BackButton" Style="{StaticResource Btn}" Content="_Back" Margin="0,0,10,0" DockPanel.Dock="Right"/>
            <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="Cancel" DockPanel.Dock="Left"/>
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
